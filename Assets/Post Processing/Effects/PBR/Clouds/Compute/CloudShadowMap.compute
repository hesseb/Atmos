#pragma kernel CSCloudShadow

#include "Assets/Scripts/Shader Common/GeoMath.hlsl"
#include "Assets/Post Processing/Effects/PBR/Clouds/Shader Common/CloudCommon.hlsl"

// How much sunlight reaches each point on the globe after passing through the cloud shell.
RWTexture2D<float4> Result;
float3 shadowSunDir;
float shadowGroundRadius;
int shadowSteps;
float shadowAbsorption;
float shadowDetailScale;

///////// External entry points /////////////////

[numthreads(8, 8, 1)]
void CSCloudShadow(uint3 id : SV_DispatchThreadID)
{
	uint width, height;
	Result.GetDimensions(width, height);
	if (id.x >= width || id.y >= height) { return; }

	float2 uv = (id.xy + 0.5) / float2(width, height);
	float3 sphereNormal = uvToPointOnSphere(uv);

	if (dot(sphereNormal, shadowSunDir) <= 0)
	{
		Result[id.xy] = 1;
		return;
	}

	float3 origin = sphereNormal * shadowGroundRadius;

	float start = cloudRaySphere(cloudInnerRadius, origin, shadowSunDir).y;
	float end = cloudRaySphere(cloudOuterRadius, origin, shadowSunDir).y;
	float stepSize = (end - start) / max(1, shadowSteps);

	float texelWorldSize = 2 * PI * cloudInnerRadius / max(1, width);
	float sampleFootprint = max(stepSize, texelWorldSize * shadowDetailScale);

	float opticalDepth = 0;
	for (int i = 0; i < shadowSteps; i++)
	{
		float3 pos = origin + shadowSunDir * (start + (i + 0.5) * stepSize);
		// `cheap` skips detail erosion, which is invisible at this footprint
		const bool cheap = true;
		opticalDepth += max(0, sampleCloudDensity(pos, cheap, sampleFootprint)) * stepSize;
	}

	Result[id.xy] = exp(-opticalDepth * shadowAbsorption);
}
