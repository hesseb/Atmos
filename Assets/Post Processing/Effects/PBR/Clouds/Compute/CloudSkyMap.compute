#pragma kernel CSCloudSkyMap

#include "Assets/Scripts/Shader Common/GeoMath.hlsl"
#include "Assets/Post Processing/Effects/PBR/Clouds/Shader Common/CloudLightingCommon.hlsl"

// What the cloud deck looks like from below, and how much sky it hides, for the sky terms of the ocean and terrain.
//   rgb  radiance leaving the deck's underside, in display space like the march and sampleSkyViewSafe
//   a    sky occlusion: 1 - transmittance looking straight up through the deck
RWTexture2D<float4> Result;
int cloudSkySteps;
float cloudSkyDetailScale;

///////// External entry points /////////////////

[numthreads(8, 8, 1)]
void CSCloudSkyMap(uint3 id : SV_DispatchThreadID)
{
	uint width, height;
	Result.GetDimensions(width, height);
	if (id.x >= width || id.y >= height)
	{
		return;
	}

	float2 uv = (id.xy + 0.5) / float2(width, height);
	float3 up = uvToPointOnSphere(uv);

	// Upward from the base, since consumers below the deck see the underside
	float3 base = up * cloudInnerRadius;
	float stepSize = (cloudOuterRadius - cloudInnerRadius) / max(1, cloudSkySteps);

	float texelWorldSize = 2 * PI * cloudInnerRadius / max(1, width);
	float sampleFootprint = max(stepSize, texelWorldSize * cloudSkyDetailScale);

	float cosUpSun = dot(up, cloudSunDir);
	float phase = cloudPhase(cosUpSun, cloudSilverIntensity);

	float3 ambient = cloudSkyAmbient(up) + cloudNightAmbientAt(up);
	bool moonActive = cloudMoonActive();

	float transmittance = 1;
	float3 luminance = 0;

	for (int i = 0; i < cloudSkySteps; i++)
	{
		float3 pos = base + up * ((i + 0.5) * stepSize);

		float density = sampleCloudDensity(pos, false, sampleFootprint);
		if (density <= 0)
		{
			continue;
		}

		float3 inScatter = cloudSunInScatter(pos, cosUpSun, phase) + ambient;
		if (moonActive)
		{
			inScatter += cloudMoonInScatter(pos, up);
		}
		cloudIntegrateStep(inScatter, density, stepSize, transmittance, luminance);

		if (transmittance < 0.01)
		{
			break;
		}
	}

	Result[id.xy] = float4(luminance, 1 - transmittance);
}
