#pragma kernel CSWeatherMap

#include "Assets/Scripts/Shader Common/GeoMath.hlsl"
#include "Assets/Post Processing/Effects/PBR/Clouds/Shader Common/CloudNoiseCommon.hlsl"

// Schneider's weather map, on a globe
RWTexture2D<float4> Result;
RWTexture2D<float4> ResultHigh;

int octaves;
float lacunarity;
float gain;
float weatherRangeGain;
float3 windOffset;
float weatherSeed;

float coverageScale;
float coverageBias;
float coverageContrast;
float typeScale;
float typeBias;
float typeContrast;
float typeWindFactor;
float precipitationScale;
float precipitationBias;
float precipitationWindFactor;
float baseHeightScale;
float baseHeightBias;
float baseHeightWindFactor;

float highCoverageScale;
float highCoverageBias;
float highCoverageContrast;
float highCoverageWindFactor;
float highFormScale;
float highFormBias;
float highFormWindFactor;

// Arbitrary/Authorable offsets
static const float TYPE_SEED = 31.7;
static const float PRECIPITATION_SEED = -17.3;
static const float BASE_HEIGHT_SEED = 73.1;
static const float HIGH_COVERAGE_SEED = 53.9;
static const float HIGH_FORM_SEED = -91.4;

static const int MIN_OCTAVES = 2;
static const int TYPE_OCTAVE_DROP = 2;
static const int PRECIPITATION_OCTAVE_DROP = 1;
static const int BASE_HEIGHT_OCTAVE_DROP = 2;
static const int HIGH_COVERAGE_OCTAVE_DROP = 2;
static const int HIGH_FORM_OCTAVE_DROP = 3;

///////// Internal helpers /////////////

float weatherNoise(float3 p, float scale, float3 offset, int octaveCount, float bias)
{
	float noise = cloudFbm(p * scale + offset + weatherSeed, octaveCount, lacunarity, gain);
	return noise * weatherRangeGain * 0.5 + 0.5 + bias;
}

float weatherContrast(float value, float contrast)
{
	float halfWidth = 0.5 / max(0.01, contrast);
	return saturate(cloudRemap(value, 0.5 - halfWidth, 0.5 + halfWidth, 0, 1));
}

int weatherOctaves(int drop)
{
	return max(MIN_OCTAVES, octaves - drop);
}

///////// External entry points /////////////////

[numthreads(8, 8, 1)]
void CSWeatherMap(uint3 id : SV_DispatchThreadID)
{
	uint width, height;
	Result.GetDimensions(width, height);
	if (id.x >= width || id.y >= height)
	{
		return;
	}

	float2 uv = (id.xy + 0.5) / float2(width, height);
	float3 p = uvToPointOnSphere(uv);

	float coverage = saturate(weatherNoise(p, coverageScale, windOffset, octaves, coverageBias));
	coverage = weatherContrast(coverage, coverageContrast);

	float precipitation = saturate(weatherNoise(p, precipitationScale, windOffset * precipitationWindFactor + PRECIPITATION_SEED,
		weatherOctaves(PRECIPITATION_OCTAVE_DROP), precipitationBias) * coverage);

	float type = saturate(weatherNoise(p, typeScale, windOffset * typeWindFactor + TYPE_SEED,
		weatherOctaves(TYPE_OCTAVE_DROP), typeBias));
	type = weatherContrast(type, typeContrast);

	float baseHeight = saturate(weatherNoise(p, baseHeightScale, windOffset * baseHeightWindFactor + BASE_HEIGHT_SEED,
		weatherOctaves(BASE_HEIGHT_OCTAVE_DROP), baseHeightBias));

	Result[id.xy] = float4(coverage, precipitation, type, baseHeight);

	float highCoverage = saturate(weatherNoise(p, highCoverageScale, windOffset * highCoverageWindFactor + HIGH_COVERAGE_SEED,
		weatherOctaves(HIGH_COVERAGE_OCTAVE_DROP), highCoverageBias));
	highCoverage = weatherContrast(highCoverage, highCoverageContrast);

	float highForm = saturate(weatherNoise(p, highFormScale, windOffset * highFormWindFactor + HIGH_FORM_SEED,
		weatherOctaves(HIGH_FORM_OCTAVE_DROP), highFormBias));

	ResultHigh[id.xy] = float4(highCoverage, highForm, 0, 0);
}
