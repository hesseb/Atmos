#pragma kernel CSNoise
#pragma kernel CSNormalize

#include "Assets/Post Processing/Effects/PBR/Clouds/Shader Common/CloudNoiseCommon.hlsl"

// Generates the two 3D noise volumes the cloud density model samples, one channel per dispatch.
//   Shape  128^3 RGBA   R = Perlin-Worley, G/B/A = Worley FBM at increasing frequency
//   Detail  32^3 RGB    Worley FBM at increasing frequency
// Layout from Schneider (SIGGRAPH 2015). Everything must tile, since the volumes repeat across the globe.
// Adapted from NoiseGenCompute.compute in Sebastian Lague's Clouds (github.com/SebLague/Clouds, MIT).

static const int THREAD_GROUP_SIZE = 8;
// int, because there is no atomic min/max for float. From Lague's Clouds.
static const int MIN_MAX_SCALE = 10000000;

// Output
uint resolution;
RWTexture3D<float4> Result;
float4 channelMask;
RWStructuredBuffer<int> minMax;

// Worley
StructuredBuffer<float3> pointsA;
StructuredBuffer<float3> pointsB;
StructuredBuffer<float3> pointsC;
int numCellsA;
int numCellsB;
int numCellsC;
float worleyPersistence;
bool invertWorley;
int tile;

// Perlin, for the shape volume's R channel only
bool usePerlinWorley;
int perlinPeriod;
int perlinOctaves;
float perlinPersistence;
// Stretches the FBM to fill [-1, 1] before it is folded to [0, 1]; see CloudNoiseSettings.perlinGain
float perlinGain;

static const int NEIGHBOUR_COUNT = 27;

///////// Internal helpers /////////////

int3 neighbourOffset(int index)
{
	return int3(index % 3, (index / 3) % 3, index / 9) - 1;
}

// Cellular noise after Worley, "A Cellular Texture Basis Function" (SIGGRAPH 1996), with one jittered point per cell instead of a Poisson count.
// Tiling from Lague's Clouds
float worley(StructuredBuffer<float3> points, int numCells, float3 samplePos)
{
	samplePos = (samplePos * tile) % 1;
	int3 cellID = floor(samplePos * numCells);
	float minSqrDst = 1;

	for (int cellOffsetIndex = 0; cellOffsetIndex < NEIGHBOUR_COUNT; cellOffsetIndex++)
	{
		int3 adjID = cellID + neighbourOffset(cellOffsetIndex);

		if (any(adjID < 0) || any(adjID >= numCells))
		{
			int3 wrappedID = (adjID + numCells) % (uint3)numCells;
			int adjCellIndex = wrappedID.x + numCells * (wrappedID.y + wrappedID.z * numCells);
			float3 wrappedPoint = points[adjCellIndex];

			for (int wrapOffsetIndex = 0; wrapOffsetIndex < NEIGHBOUR_COUNT; wrapOffsetIndex++)
			{
				float3 sampleOffset = samplePos - (wrappedPoint + neighbourOffset(wrapOffsetIndex));
				minSqrDst = min(minSqrDst, dot(sampleOffset, sampleOffset));
			}
		}
		else
		{
			int adjCellIndex = adjID.x + numCells * (adjID.y + adjID.z * numCells);
			float3 sampleOffset = samplePos - points[adjCellIndex];
			minSqrDst = min(minSqrDst, dot(sampleOffset, sampleOffset));
		}
	}

	return sqrt(minSqrDst);
}

// Three octaves weighted by persistence, from Lague's Clouds
float worleyFbm(float3 pos)
{
	float octaveA = worley(pointsA, numCellsA, pos);
	float octaveB = worley(pointsB, numCellsB, pos);
	float octaveC = worley(pointsC, numCellsC, pos);

	float amplitudeB = worleyPersistence;
	float amplitudeC = worleyPersistence * worleyPersistence;
	float fbm = (octaveA + octaveB * amplitudeB + octaveC * amplitudeC) / (1 + amplitudeB + amplitudeC);

	// Inverted for tightly packed billows, after Schneider (SIGGRAPH 2015)
	return invertWorley ? 1 - fbm : fbm;
}

// Perlin-Worley after Schneider as in Hillaire's TileableVolumeNoise (github.com/sebh/TileableVolumeNoise)
float perlinWorley(float3 pos, float worley)
{
	float perlin = cloudPerlinFbmTileable(pos, perlinPeriod, perlinOctaves, perlinPersistence);
	perlin = saturate(perlin * perlinGain * 0.5 + 0.5);
	return cloudRemap(perlin, 0.0, 1.0, worley, 1.0);
}

// Channel mask from Lague's Clouds
void writeChannel(uint3 id, float4 value)
{
	Result[id] = lerp(Result[id], value, channelMask);
}

///////// External entry points /////////////////

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, THREAD_GROUP_SIZE)]
void CSNoise(uint3 id : SV_DispatchThreadID)
{
	if (any(id >= resolution))
	{
		return;
	}

	float3 pos = id / (float)resolution;

	float noise = worleyFbm(pos);
	if (usePerlinWorley)
	{
		noise = perlinWorley(pos, noise);
	}

	int scaled = (int)(saturate(noise) * MIN_MAX_SCALE);
	InterlockedMin(minMax[0], scaled);
	InterlockedMax(minMax[1], scaled);

	writeChannel(id, noise);
}

// Min/max normalize pass from Lague's Clouds.
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, THREAD_GROUP_SIZE)]
void CSNormalize(uint3 id : SV_DispatchThreadID)
{
	if (any(id >= resolution))
	{
		return;
	}

	float minValue = (float)minMax[0] / MIN_MAX_SCALE;
	float maxValue = (float)minMax[1] / MIN_MAX_SCALE;

	writeChannel(id, (Result[id] - minValue) / max(1e-5, maxValue - minValue));
}
