#pragma kernel CreateTransmittanceLUT
#include "Assets/Scripts/Shader Common/AtmosphereCommon.hlsl"

// Header revision this file was last rebuilt against: 750 km planet + densityMultiplier.

// Unity does not reliably rebuild a .compute when an included .hlsl changes. If the atmosphere's
// output looks stale after editing anything under Shader Common, reimport this file.

RWTexture2D<float3> TransmittanceLUT;

uint width;
uint height;

[numthreads(8,8,1)]
void CreateTransmittanceLUT (uint2 id : SV_DispatchThreadID)
{
	// The bounds check every other kernel in this folder has. Free today since 256x64 divides the
	// 8x8 group evenly, but not if transmittanceLutSize is ever set to something that doesn't.
	if (id.x >= width || id.y >= height) { return; }

	// Texel centres, not id/(size-1), matching how the sampler reads. lutUnitToSubUv and
	// transmittanceLutParams are the write/read pair for this mapping.
	float2 uv = (id + 0.5) / float2(width, height);

	// Through the shared inverse mapping, so what is written here and what
	// sampleTransmittanceLUT reads can never disagree.
	float radius, cosZenith;
	transmittanceLutParams(uv, radius, cosZenith);

	float3 inPoint = float3(0, radius, 0);

	// sqrt(1 - c^2) is sin(acos(c)) without the round trip through two transcendentals.
	float sinZenith = sqrt(saturate(1 - cosZenith * cosZenith));
	float3 dir = float3(sinZenith, cosZenith, 0);

	float3 transmittance = getSunTransmittance(inPoint, dir);

	TransmittanceLUT[id.xy] = transmittance;
}
