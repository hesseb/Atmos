#pragma kernel RenderSkyViewLUT
#include "Assets/Scripts/Shader Common/AtmosphereCommon.hlsl"
#include "../Shader Common/SkyViewCommon.hlsl"

// Sky radiance as a function of direction: The atmosphere's spherical symmetry means the sky only depends on local sun elevation and direction relative to (up, sun)
// meaning the LUT changes only with the sun, never with the camera.

RWTexture2D<float4> SkyViewOutputLUT;
sampler2D TransmittanceLUT;
int numSkyViewSteps;

[numthreads(8, 8, 1)]
void RenderSkyViewLUT(uint3 id : SV_DispatchThreadID)
{
	uint2 size = (uint2)skyViewLutSize;
	
	if (id.x >= size.x || id.y >= size.y)
	{
		return;
	}

	float cosViewZenith, cosAzimuth;
	skyViewLutParams( ( id.xy + 0.5 ) / skyViewLutSize, skyViewLutRadius, cosViewZenith, cosAzimuth );

	float3 origin = float3(0, skyViewLutRadius, 0);
	float sinZenith = sqrt(saturate(1 - cosViewZenith * cosViewZenith));
	float sinAzimuth = sqrt(saturate(1 - cosAzimuth * cosAzimuth));
	float3 viewDir = float3(sinZenith * cosAzimuth, cosViewZenith, sinZenith * sinAzimuth);

	float3 luminance = 0;
	SphereChord hitInfo = raySphereChordAtOrigin(atmosphereRadius, origin, viewDir);
	if (hitInfo.dstThrough > 0)
	{
		float3 inPoint = origin + viewDir * hitInfo.dstTo;
		luminance = marchScattering(inPoint, viewDir, hitInfo.dstThrough, numSkyViewSteps, TransmittanceLUT, planetRadius).luminance;
	}

	SkyViewOutputLUT[id.xy] = float4(luminance, 1);
}
