#pragma kernel CSMain
#include "Assets/Scripts/Shader Common/AtmosphereCommon.hlsl"
#include "../Shader Common/ViewRayCommon.hlsl"

RWTexture3D<float4> AerialLuminanceLUT;
RWTexture3D<float4> AerialTransmittanceLUT;
sampler2D TransmittanceLUT;

uint size;
int stepsPerSlice;

// One thread per (x, y)
[numthreads(8, 8, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= size || id.y >= size)
	{
		return;
	}

	float2 uv = (id.xy + 0.5) / size;
	float3 rayDir = calculateViewDir(uv);

	SphereChord atmosphereHit = raySphereChordAtOrigin(atmosphereRadius, camPos, rayDir);
	float dstToAtmosphere = atmosphereHit.dstTo;
	float dstThroughAtmosphere = atmosphereHit.dstThrough;

	float3 inPoint = camPos + rayDir * dstToAtmosphere;
	float maxLength = dstThroughAtmosphere;
	float dstToGround = rayIntersectSphereAtOrigin(inPoint, rayDir, planetRadius);

	if (dstToGround > 0)
	{
		maxLength = min(maxLength, dstToGround);
	}

	float horizonDst = sqrt(max(0, dot(inPoint, inPoint) - planetRadius * planetRadius));
	maxLength = min(maxLength, horizonDst);

	ScatteringState state;
	state.luminance = 0;
	state.transmittance = 1;
	float marched = 0;

	for (uint z = 0; z < size; z++)
	{
		float depthT = (z + 0.5) / size;
		float target = depthT * maxLength;

		if (dstThroughAtmosphere > 0 && target > marched)
		{
			marchScatteringSegment(state, inPoint + rayDir * marched, rayDir, target - marched,
				stepsPerSlice, TransmittanceLUT, 0);
			marched = target;
		}

		float avgTransmittance = dot(state.transmittance, 1 / 3.0);

		AerialLuminanceLUT[uint3(id.xy, z)] = float4(state.luminance, avgTransmittance);
		AerialTransmittanceLUT[uint3(id.xy, z)] = float4(state.transmittance, depthT);
	}
}
