#pragma kernel CSMain
#include "Assets/Scripts/Shader Common/AtmosphereCommon.hlsl"
#include "../Shader Common/RaymarchCommon.hlsl"

// Header revision this file was last rebuilt against: continuous horizon span.

// Unity does not reliably rebuild a .compute when an included .hlsl changes. If the atmosphere's
// output looks stale after editing anything under Shader Common, reimport this file.

RWTexture3D<float4> AerialPerspectiveLuminance;
RWTexture3D<float4> AerialPerspectiveTransmittance;
sampler2D TransmittanceLUT;

uint size;
int stepsPerSlice;

// One thread per (x, y), marching the depth slices in order as a single continued march, rather
// than one thread per voxel re-marching from the camera for every slice. This is both cheaper and
// makes luminance non-decreasing and transmittance non-increasing by construction across slices -
// an exact property the harness can assert, which independent per-slice marches could not guarantee.
[numthreads(8, 8, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= size || id.y >= size) { return; }

	// Texel centres, (id.xy + 0.5) / size, not id.xy / (size - 1) - matches how Atmosphere.shader
	// samples this volume with tex3Dlod at a raw screen uv, avoiding a half-texel misregistration
	// between the aerial haze and the terrain it belongs to.
	float2 uv = (id.xy + 0.5) / size;

	float3 rayDir = calculateViewDir(uv);

	// camPos, not the camera's near plane - must match the origin the composite shader uses for its
	// own ray-sphere test, since the depth axis is defined relative to that intersection.
	float2 atmosphereHitInfo = raySphere(0, atmosphereRadius, camPos, rayDir);
	float dstToAtmosphere = atmosphereHitInfo.x;
	float dstThroughAtmosphere = atmosphereHitInfo.y;

	float3 inPoint = camPos + rayDir * dstToAtmosphere;

	// Clip at the ground once, up front, rather than inside each slice's march: raymarchSegment()
	// (unlike raymarch()) doesn't reclip internally, since a later segment would otherwise re-derive
	// ground distance relative to its own origin.
	float maxLength = dstThroughAtmosphere;
	float dstToGround = rayIntersectSphere(inPoint, rayDir, planetRadius);
	if (dstToGround > 0) { maxLength = min(maxLength, dstToGround); }

	// Cap the span at the tangent-point distance so the depth axis stays CONTINUOUS across the
	// horizon - without it, adjacent screen texels straddling the horizon jump between wildly
	// different ray lengths, smearing into a bright serrated band. Free on the ground side: it only
	// truncates rays that miss the planet, which take the sky branch and never read this LUT.
	float horizonDst = sqrt(max(0, dot(inPoint, inPoint) - planetRadius * planetRadius));
	maxLength = min(maxLength, horizonDst);

	ScatteringState state;
	state.luminance = 0;
	state.transmittance = 1;

	float marched = 0;

	for (uint z = 0; z < size; z++) {
		// (z + 0.5) / size, not z / (size - 1) - same texel-centre reasoning as the xy mapping
		// above, matching how the composite shader samples this texture with tex3Dlod.
		float depthT = (z + 0.5) / size;

		// The depth axis spans the air in front of THIS ray (`maxLength`, the atmosphere chord
		// already clipped at the ground) rather than a fixed distance from the camera. A fixed
		// range concentrates or wastes samples depending on altitude, which reads as banding on a
		// sphere; normalising per ray gives every ray full coverage regardless of altitude.
		float target = depthT * maxLength;

		if (dstThroughAtmosphere > 0 && target > marched) {
			// dont include earth shadow (causes issues due to low texture size)
			raymarchSegment(state, inPoint + rayDir * marched, rayDir, target - marched,
				stepsPerSlice, TransmittanceLUT, 0);
			marched = target;
		}

		float avgTransmittance = dot(state.transmittance, 1 / 3.0);

		AerialPerspectiveLuminance[uint3(id.xy, z)] = float4(state.luminance, avgTransmittance);
		AerialPerspectiveTransmittance[uint3(id.xy, z)] = float4(state.transmittance, depthT);
	}
}
