#pragma kernel CSBaselineCloudShadow

#include "Assets/Scripts/Shader Common/GeoMath.hlsl"
#include "Assets/Post Processing/Effects/Baseline/Clouds/Shader Common/BaselineCloudCommon.hlsl"

// How much sunlight reaches each point on the globe after passing through the baseline's cloud
// decks. Publishes the same globals the volumetric's shadow pass does (CloudShadowMap,
// cloudShadowStrength), so Terrain.shader and Ocean.shader need no change and cannot tell which
// renderer wrote the map. Without this the baseline would be missing a feature rather than merely
// rendering it more cheaply, confounding the comparison. Also its own clean cost sub-comparison: one
// texture tap per deck here against the volumetric's ten-step density march, same output and resolution.

RWTexture2D<float4> Result;

float2 shadowMapSize;
float3 shadowSunDir;

/// Widens the footprint each deck is read at, beyond what the map itself can represent - same
/// control the volumetric's shadow pass needs, for the same reason: finer detail just aliases and
/// drifts into flicker.
float shadowDetailScale;

/// Transmittance through one deck, along the ray from `origin` toward the sun. Geometric rather than
/// a straight-down projection, so at low sun the shadow lands far from the cloud above it - what
/// makes long evening shadows read as belonging to the clouds that cast them.
float baselineDeckTransmittance(
	Texture2D<float4> layerTex, SamplerState layerSampler, BaselineLayer layer,
	float3 origin, float texelWorldSize)
{
	// From the ground the origin is inside the deck's sphere, so this is the exit hit through the sheet.
	float t = baselineLayerHit(layer.radius, origin, shadowSunDir);
	if (t < 0) { return 1; }

	float3 up = normalize(origin + shadowSunDir * t);
	float cosIncidence = abs(dot(shadowSunDir, up));

	float4 texel;
	float alpha = baselineLayerCoverage(
		layerTex, layerSampler, layer, up, cosIncidence,
		baselineLodForFootprint(layer, texelWorldSize * shadowDetailScale), texel);

	return 1 - alpha;
}

[numthreads(8, 8, 1)]
void CSBaselineCloudShadow(uint3 id : SV_DispatchThreadID)
{
	uint2 size = (uint2)shadowMapSize;
	if (id.x >= size.x || id.y >= size.y) { return; }

	float2 uv = (id.xy + 0.5) / shadowMapSize;
	float3 sphereNormal = uvToPointOnSphere(uv);

	// Nothing to shadow once the sun is below the local horizon.
	if (dot(sphereNormal, shadowSunDir) <= 0)
	{
		Result[id.xy] = 1;
		return;
	}

	float3 origin = sphereNormal * baselineBodyRadius;

	// Read at the footprint of a shadow map texel, not the deck texture's own resolution - this fixed
	// global grid can't hold detail finer than two texels.
	float texelWorldSize = 6.28318530718 * baselineBodyRadius / max(1, shadowMapSize.x);

	float transmittance = baselineDeckTransmittance(
		BaselineCloudLayerA, samplerBaselineCloudLayerA, baselineLayerA(), origin, texelWorldSize);

	// Multiplied, not added: two decks in series attenuate, putting a doubly-shadowed patch under both.
	if (baselineLayerCount > 1)
	{
		transmittance *= baselineDeckTransmittance(
			BaselineCloudLayerB, samplerBaselineCloudLayerB, baselineLayerB(), origin, texelWorldSize);
	}

	Result[id.xy] = transmittance;
}
