#pragma kernel CSCloudSkyMap

#include "Assets/Scripts/Shader Common/GeoMath.hlsl"
// The optical model (phase, Beer-Powder, cone light march) and through it the density model, shared
// with the view-ray march so the deck's underside cannot disagree with the cloud drawn above it.
#include "Assets/Post Processing/Effects/Clouds/Shader Common/CloudLightingCommon.hlsl"
// sampleLightColourAt and sampleSkyViewSafe, the same two the march lights each sample with.
#include "Assets/Scripts/Shader Common/SurfaceLighting.hlsl"

// What the cloud deck looks like from below, and how much sky it hides - needed because the ocean
// and terrain darken their direct sun via the cloud shadow map, but their sky terms knew nothing
// about cloud (so an overcast sunset sea still reflected a clear sky).
//
//   rgb  radiance leaving the deck's underside, in DISPLAY space (matching the march and
//        sampleSkyViewSafe, so consumers aren't lerping between different exposures)
//   a    sky occlusion: 1 - transmittance looking straight up through the deck
//
// Equirectangular, indexed by pointToUV like every other global field here: view-independent,
// scale-invariant, and one tap per consumer.

RWTexture2D<float4> Result;

float2 cloudSkyMapSize;
float3 cloudSkySunDir;

/// Steps up through the shell from the base. Fewer than the view march by a wide margin: this is a
/// low-resolution field with no high-frequency detail, and every step pays for a cone light march.
int cloudSkySteps;

/// Widens the footprint the density is read at, beyond what this fixed global grid can represent -
/// the same reason the shadow map needs it: finer detail just aliases, and drifts as the deck moves.
float cloudSkyDetailScale;

// The march's own lighting parameters, bound identically so the two agree.
float3 cloudSunColour;
float cloudSunIntensity;
float cloudSunTransmittanceWeight;
float cloudAmbientIntensity;
float cloudAmbientHorizon;
float3 cloudAmbientFallback;
float3 cloudNightAmbient;
float cloudSilverIntensity;
float cloudExtinction;

[numthreads(8, 8, 1)]
void CSCloudSkyMap(uint3 id : SV_DispatchThreadID)
{
	uint2 size = (uint2)cloudSkyMapSize;
	if (id.x >= size.x || id.y >= size.y) { return; }

	float2 uv = (id.xy + 0.5) / cloudSkyMapSize;
	float3 sphereNormal = uvToPointOnSphere(uv);

	// Marches up through the shell from the base, since the consumer (sea and land below the deck,
	// looking up) needs what leaves the underside - marching top-down would give the sunlit top instead.
	float3 up = sphereNormal;
	float span = cloudOuterRadius - cloudInnerRadius;
	float stepSize = span / max(1, cloudSkySteps);

	// Lifted clear of the inner sphere rather than started exactly on it - see CloudShadowMap.compute
	// for why exactly-on-boundary rounding matters here.
	float3 base = sphereNormal * (cloudInnerRadius + 1e-2);

	// Read at the footprint of a map texel, not of a march step - this fixed global grid can't
	// represent anything finer, so reading more just aliases and drifts.
	float texelWorldSize = 6.28318530718 * cloudInnerRadius / max(1, cloudSkyMapSize.x);
	float sampleFootprint = max(stepSize, texelWorldSize * cloudSkyDetailScale);

	// Phase argument is the cosine between the view ray (up, for an observer below the deck) and the
	// sun - near +1 with the sun overhead, the forward lobe, which is why a thin overcast glows from
	// underneath. Silver lining is kept here (unlike the moon term and aerial perspective) since this
	// is a different query from the view march, not the same one restated.
	float cosUpSun = dot(up, cloudSkySunDir);
	float phase = cloudPhase(cosUpSun, cloudSilverIntensity);

	float nightT = saturate(dot(sphereNormal, -cloudSkySunDir));

	// Skylight arriving at the deck, sampled toward the sunlit horizon as well as the zenith (as the
	// march does), so a sunset's orange horizon carries onto the underside rather than just the blue zenith.
	float3 sunTangent = cloudSkySunDir - sphereNormal * dot(cloudSkySunDir, sphereNormal);
	float tangentLength = length(sunTangent);
	float3 horizonDir = tangentLength > 1e-3 ? sunTangent / tangentLength : sphereNormal;

	float3 skyZenith = sampleSkyViewSafe(sphereNormal, sphereNormal, cloudSkySunDir);
	float3 skyHorizon = sampleSkyViewSafe(sphereNormal, horizonDir, cloudSkySunDir);
	float3 ambient = lerp(skyZenith, skyHorizon, cloudAmbientHorizon) * cloudAmbientIntensity;
	ambient += cloudAmbientFallback * (hasPhysicalAtmosphere() ? 0.0 : 1.0);
	ambient += cloudNightAmbient * smoothstep(0.0, 0.15, nightT);

	float transmittance = 1;
	float3 luminance = 0;

	for (int i = 0; i < cloudSkySteps; i++)
	{
		float3 pos = base + up * ((i + 0.5) * stepSize);

		float density = sampleCloudDensity(pos, false, sampleFootprint);
		if (density <= 0) { continue; }

		// The sun's colour at this altitude, desaturated toward its own luminance by the same weight the march uses.
		float3 sunTransmittance = sampleLightColourAt(pos, cloudSkySunDir);
		float sunLuminance = dot(sunTransmittance, float3(0.2126, 0.7152, 0.0722));
		float3 sunColour = lerp(sunLuminance.xxx, sunTransmittance, cloudSunTransmittanceWeight) * cloudSunColour;

		float energy = cloudBeerPowder(cloudLightMarch(pos, cloudSkySunDir), cosUpSun);

		float3 inScatter = sunColour * energy * phase * cloudSunIntensity + ambient;

		// Same analytic per-step integration the march uses: scattering and extinction cancel for a
		// purely scattering medium, leaving exactly (1 - stepTransmittance).
		float stepTransmittance = exp(-density * stepSize * cloudExtinction);
		luminance += inScatter * (1 - stepTransmittance) * transmittance;
		transmittance *= stepTransmittance;

		if (transmittance < 0.01) { break; }
	}

	// max(0): toneMap(0) is slightly negative, so an unclamped zero would subtract from what it's lerped into.
	Result[id.xy] = float4(max(0, luminance), 1 - transmittance);
}
