%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61e6c43eeccd4824aa7a0c699b2bd99e, type: 3}
  m_Name: altitude
  m_EditorClassIdentifier: Assembly-CSharp::BenchmarkDefinition
  id: altitude
  description: Continuous climb from altitude 4 to 220 at a fixed nadir-ish pitch.
    Sweeps sky fraction and exercises the whole LOD range. Altitude interpolates
    logarithmically, so the apparent zoom rate is constant.
  bootFrames: 60
  prewarmPosesEvery: 40
  warmupFrames: 120
  defaultSettleFrames: 12
  flushFrames: 16
  simulatedFps: 60
  monthT: 0.404
  yearT: 0.288
  segments:
  - label: climb
    kind: 0
    frames: 900
    settleFramesOverride: 0
    from:
      source: 0
      inlineView:
        coordinate:
          longitude: 8
          latitude: 46.5
        altitude: 4
        pitch: 75
        heading: 0
        roll: 0
        fieldOfView: 60
      bookmarkAsset: {fileID: 0}
      bookmarkLabel: 
      bookmarkIndex: 0
    to:
      source: 0
      inlineView:
        coordinate:
          longitude: 8
          latitude: 46.5
        altitude: 220
        pitch: 75
        heading: 0
        roll: 0
        fieldOfView: 60
      bookmarkAsset: {fileID: 0}
      bookmarkLabel: 
      bookmarkIndex: 0
    ease: 0
    sweepDegrees: 0
    sweepAxis: 0
    sunFrom:
      mode: 2
      dayT: 0
      elevationDegrees: 0
      rising: 0
      highest: 1
    sunTo:
      mode: 2
      dayT: 0
      elevationDegrees: 0
      rising: 0
      highest: 1
    screenshotFirstAndLast: 0
    screenshotFrames: 
  - label: descend
    kind: 0
    frames: 900
    settleFramesOverride: 0
    from:
      source: 0
      inlineView:
        coordinate:
          longitude: 8
          latitude: 46.5
        altitude: 220
        pitch: 75
        heading: 0
        roll: 0
        fieldOfView: 60
      bookmarkAsset: {fileID: 0}
      bookmarkLabel: 
      bookmarkIndex: 0
    to:
      source: 0
      inlineView:
        coordinate:
          longitude: 8
          latitude: 46.5
        altitude: 4
        pitch: 75
        heading: 0
        roll: 0
        fieldOfView: 60
      bookmarkAsset: {fileID: 0}
      bookmarkLabel: 
      bookmarkIndex: 0
    ease: 0
    sweepDegrees: 0
    sweepAxis: 0
    sunFrom:
      mode: 2
      dayT: 0
      elevationDegrees: 0
      rising: 0
      highest: 1
    sunTo:
      mode: 2
      dayT: 0
      elevationDegrees: 0
      rising: 0
      highest: 1
    screenshotFirstAndLast: 0
    screenshotFrames: 
