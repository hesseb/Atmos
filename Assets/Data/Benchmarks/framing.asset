  m_Script: {fileID: 11500000, guid: 61e6c43eeccd4824aa7a0c699b2bd99e, type: 3}
  m_Name: framing
  m_EditorClassIdentifier: Assembly-CSharp::BenchmarkDefinition
  id: framing
  description: Four holds from one position, varying only pitch. Isolates the effect
    of sky-to-terrain ratio on atmosphere cost with everything else held fixed. Sky
    fraction runs roughly 0.0 at nadir to 0.9 at the horizon.
  bootFrames: 60
  prewarmPosesEvery: 40
  warmupFrames: 120
  defaultSettleFrames: 12
  flushFrames: 16
  simulatedFps: 60
  monthT: 0.404
  yearT: 0.288
  segments:
  - label: nadir
    kind: 1
    frames: 500
    settleFramesOverride: 0
    from:
      source: 0
      inlineView:
        coordinate:
          longitude: 8
          latitude: 46.5
        altitude: 3.64
        pitch: 90
        heading: 0
        roll: 0
        fieldOfView: 60
      bookmarkAsset: {fileID: 0}
      bookmarkLabel: 
      bookmarkIndex: 0
    to:
      source: 0
      inlineView:
        coordinate:
          longitude: 8
          latitude: 46.5
        altitude: 3.64
        pitch: 90
        heading: 0
        roll: 0
        fieldOfView: 60
      bookmarkAsset: {fileID: 0}
      bookmarkLabel: 
      bookmarkIndex: 0
    ease: 0
    sweepDegrees: 0
    sweepAxis: 0
    sunFrom:
      mode: 2
      dayT: 0
      elevationDegrees: 0
      rising: 0
      highest: 1
    sunTo:
      mode: 2
      dayT: 0
      elevationDegrees: 0
      rising: 0
      highest: 1
    screenshotFirstAndLast: 0
    screenshotFrames: fa000000
